// FIX 1: SilentCommService now implements CoroutineScope for proper lifecycle management.
class SilentCommService(
    private val userId: String
) : CoroutineScope {
    // Coroutine setup tied to a job that can be explicitly cancelled
    private val job = SupervisorJob()
    override val coroutineContext: CoroutineContext = Dispatchers.Default + job

    private lateinit var settings: UserSettings
    private val dbManager = FirestoreManager()
    private val geminiApi = GeminiLiveApi()

    private var effectiveLocationIntervalMs: Long = LocationTracker.FASTEST_INTERVAL_MS
    private var lastIntervalCheckTime = System.currentTimeMillis()
    private val intervalCheckFrequencyMs = 5.minutes.inWholeMilliseconds // Check interval every 5 minutes

    // Mocked continuous loop for 24/7 operation
    fun startProcessingLoop() {
        // 1. Fetch user settings
        settings = dbManager.fetchUserSettings(userId)
        val alertManager = AlertManager(settings)

        // Initial interval determination
        effectiveLocationIntervalMs = LocationTracker.determineEffectiveInterval()
        lastIntervalCheckTime = System.currentTimeMillis()

        // 2. Establish Gemini Session
        geminiApi.establishSession(userId)

        println("[SERVICE] Starting 24/7 Audio Processing Loop (Initial Location Interval: ${effectiveLocationIntervalMs / 1000} seconds)...")
        var cycle = 1

        // Use CoroutineScope to launch the loop
        launch {
            while (isActive) {
                // FIX 2: Periodically check the location interval for dynamic adjustment
                if (System.currentTimeMillis() - lastIntervalCheckTime > intervalCheckFrequencyMs) {
                    val newInterval = LocationTracker.determineEffectiveInterval()
                    if (newInterval != effectiveLocationIntervalMs) {
                        effectiveLocationIntervalMs = newInterval
                        println("  [LOCATION] Interval dynamically updated to: ${effectiveLocationIntervalMs / 1000} seconds.")
                    }
                    lastIntervalCheckTime = System.currentTimeMillis()
                }

                println("\n(Cycle $cycle: Simulated ${effectiveLocationIntervalMs / 1000}s of monitoring)")

                // 3. Capture Audio & Location
                LocationTracker.getCurrentLocation()
                // Mock: Start audio capture via AudioRecord API

                // 4. Process Audio Chunk with Gemini Live API
                try {
                    // We use a fixed 5s audio chunk for AI processing regardless of location interval
                    val response = geminiApi.processAudioChunk()

                    // 5. Context-Aware Alerting
                    alertManager.triggerAlertProtocol(response)

                } catch (_: Exception) {
                    println("[ERROR] Gemini API failed")
                    // In a real app: Implement exponential backoff and retry here
                }

                cycle++
                // Loop delay based on the determined location tracking interval
                delay(effectiveLocationIntervalMs)
            }
        }
        // This line only runs if the loop is terminated by stopMonitoring (job.cancel())
        println("[SERVICE] Processing loop coroutine terminated.")
    }

    fun stopMonitoring() {
        // FIX 1: Cancel the entire CoroutineScope/Job to reliably stop all background work.
        job.cancel()
        println("[SERVICE] Monitoring job cancelled.")
    }
}

object LocationTracker {
    // Priority Intervals for Location Tracking
    const val FASTEST_INTERVAL_MS = 5000L      // 5 seconds
    const val HIGH_POWER_INTERVAL_MS = 60000L  // 1 minute
    const val LOW_POWER_INTERVAL_MS = 120000L  // 2 minutes

    fun determineEffectiveInterval(): Long {
        println("  [LOCATION] Attempting to secure preferred location update rate based on system status:")

        // Mocking the system check for battery/network status to determine the sustainable rate.
        return when (Random.nextInt(3)) {
            0 -> {
                println("  [LOCATION] Fastest rate (5 seconds) feasible due to high system capacity.")
                FASTEST_INTERVAL_MS
            }
            1 -> {
                println("  [LOCATION] Falling back to 1 minute due to battery saving mode.")
                HIGH_POWER_INTERVAL_MS
            }
            else -> {
                println("  [LOCATION] Falling back to 2 minutes due to severe battery/network restrictions.")
                LOW_POWER_INTERVAL_MS
            }
        }
    }

    fun getCurrentLocation(): Location {
        // Mock battery-optimized location services
        return Pair(34.0522, -118.2437) // Mock: Los Angeles (Lat, Lon)
    }

    fun ensureLocationIsOn() {
        // FIX 3: Corrected comment to reflect Android's security constraints.
        println("  [SYSTEM] Requesting high-accuracy location priority. User must manually enable Location if it is off.")
    }
}

