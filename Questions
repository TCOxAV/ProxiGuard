// Enums matching the structured output schema from system_architecture.md
enum class Classification { EMERGENCY, COMMAND, ANNOUNCEMENT, CASUAL_SPEECH }
enum class Priority { HIGH, MEDIUM, LOW }
enum class CommandAction { NAVIGATION, NONE }

@Serializable
data class CommandData(
    val action: CommandAction,
    val target: String?
)

/**
 * The structured JSON response expected from the Gemini Live API for every audio chunk.
 * This structure enables context-aware actions based on the AI's classification.
 */
@Serializable
data class AiResponse(
    val classification: Classification,
    val priority: Priority,
    val sourceLanguage: String,
    val originalText: String,
    val translatedText: String,
    val commandData: CommandData,
    val severityLevel: String // e.g., "1km_EARTHQUAKE" or "30m_ACCIDENT"
)

class GeminiLiveApi {
    // Mocked WebSocket connection and streaming logic
    fun establishSession(userId: String) {
        println("[GEMINI] WebSocket session established for $userId. Ready to stream audio.")
    }

    // Mocked audio processing. In reality, this would be a continuous stream of chunks.
    suspend fun processAudioChunk(): AiResponse {
        // Mock a delayed, asynchronous response from the API after processing.
        delay(Random.nextLong(500, 1500))

        // Simulate different AI outputs based on a random event
        return when (Random.nextInt(5)) {
            0 -> AiResponse(
                classification = Classification.EMERGENCY,
                priority = Priority.HIGH,
                sourceLanguage = "es",
                originalText = "¡Rompimiento de cristal! Necesito ayuda.",
                translatedText = "Glass breaking! I need help.",
                commandData = CommandData(CommandAction.NONE, null),
                severityLevel = "30m_ACCIDENT" // Small radius emergency
            )
            1 -> AiResponse(
                classification = Classification.COMMAND,
                priority = Priority.MEDIUM,
                sourceLanguage = "en",
                originalText = "I'm going to Olive Garden in Chicago.",
                translatedText = "I'm going to Olive Garden in Chicago.",
                commandData = CommandData(CommandAction.NAVIGATION, "Olive Garden, Chicago, IL"), // Specific navigation target
                severityLevel = "NONE"
            )
            2 -> AiResponse(
                classification = Classification.ANNOUNCEMENT,
                priority = Priority.LOW,
                sourceLanguage = "fr",
                originalText = "Attention, un avis de circulation.",
                translatedText = "Attention, a traffic announcement.",
                commandData = CommandData(CommandAction.NONE, null),
                severityLevel = "NONE"
            )
            3 -> AiResponse(
                classification = Classification.EMERGENCY,
                priority = Priority.HIGH,
                sourceLanguage = "en",
                originalText = "Earthquake!",
                translatedText = "Earthquake!",
                commandData = CommandData(CommandAction.NONE, null),
                severityLevel = "1km_EARTHQUAKE" // Large radius emergency
            )
            else -> AiResponse( // CASUAL_SPEECH or ignored noise
                classification = Classification.CASUAL_SPEECH,
                priority = Priority.LOW,
                sourceLanguage = "en",
                originalText = "The weather is nice today.",
                translatedText = "The weather is nice today.",
