/** Manages requests for high-priority, sustained Android permissions. */
class PermissionsManager {
    suspend fun requestEssentialPermissions(): Boolean {
        println("\n[PERMISSION] Requesting permissions for 24/7 Guardian Service:")

        // 1. Background Work Permission
        println("[PROMPT] Asking for 'Unrestricted Background Data' permission...")
        delay(500)
        println("[USER] User grants Unrestricted Background Data access.")

        // 2. Override Silent/DND Mode Permission (System Setting)
        println("[PROMPT] Asking for 'Do Not Disturb Access' to override silent mode during alarms...")
        delay(500)
        println("[USER] User grants Do Not Disturb Access.")

        // 3. Persistent Location Access (Always Allow)
        println("[PROMPT] Asking for 'Always Allow' Location Access for 24/7 monitoring...")
        LocationTracker.ensureLocationIsOn()
        delay(500)
        println("[USER] User grants Always Allow Location Access (App will continue to request high-priority location updates).")

        // 4. Microphone (Required for the service itself)
        println("[PROMPT] Asking for 'Microphone' permission (Always while using)...")
        delay(500)
        println("[USER] User grants Microphone access.")

        println("[PERMISSION] All essential permissions secured.")
        return true
    }
}

class AlertManager(private val settings: UserSettings) {
    private val peripheralManager = PeripheralManager()

    /**
     * Calculates if the user is OUTSIDE the required safety range (1km for earthquake, 30m for accident).
     */
    private fun proximityCheck(range: Double): Boolean {
        // Mocked distance calculation: returns true if OUTSIDE range
        val distance = Random.nextDouble(10.0, 5000.0) // 10m to 5km
        val requiredRange = when (range) {
            in 1000.0..Double.MAX_VALUE -> 1000.0 // 1km and up
            in 30.0..999.0 -> 30.0     // 30m and up
            else -> range
        }

        val isOutsideRange = distance > requiredRange

        if (!isOutsideRange) {
            println("[LOCATION] User is WITHIN ${String.format(Locale.US, "%.2f", distance)}m of alert. Required safety range: ${requiredRange}m.")
        } else {
            println("[LOCATION] User is OUTSIDE safety range (Distance: ${String.format(Locale.US, "%.2f", distance)}m).")
        }

        return isOutsideRange
    }

    fun triggerAlertProtocol(response: AiResponse) {
        val severityParts = response.severityLevel.split("_")
        val proximityRange = severityParts.firstOrNull()?.replace("m", "")?.replace("km", "")?.toDoubleOrNull()
            ?.let { if (severityParts.contains("km")) it * 1000 else it } ?: 0.0

        if (response.classification != Classification.CASUAL_SPEECH) {
            println("\n--- ALERT PROTOCOL TRIGGERED ---")
            println("Classification: ${response.classification}, Priority: ${response.priority}")
            println("Translated: ${response.translatedText} (Source: ${response.sourceLanguage})")
        }

        when (response.classification) {
            Classification.EMERGENCY -> {
                println("[VISUAL] Displaying UNINTERRUPTIBLE POPUP: ${response.translatedText}")
                peripheralManager.sendHaptic(settings.sirenPreference) // Strong vibration/siren based on setting

                // Proximity Check Logic
                val isSafe = proximityCheck(proximityRange)

                if (!isSafe) {
                    println("[AUTHORITY] Sending SMS to ${settings.emergencyContactNumber} with location.")
                    // In a real app, the UNINTERRUPTIBLE POPUP would remain until isSafe becomes true.
                }
            }
            Classification.COMMAND -> {
                println("[UI] Displaying command: ${response.translatedText}")
                if (response.commandData.action == CommandAction.NAVIGATION && response.commandData.target != null) {
                    println("[ACTION] Initiating Google Maps navigation to: ${response.commandData.target}")
                }
            }
            Classification.ANNOUNCEMENT -> {
                println("[UI] Displaying announcement: ${response.translatedText}")
                if (settings.wearableConnectedId != null) {
                    println("[TTS] Streaming announcement to Bluetooth earpiece.")
                    peripheralManager.sendHaptic("SOFT_VIBRATION") // Soft notification
                }
            }
            else -> {
                // Only print info for casual speech if not part of an alert block
                if (response.classification == Classification.CASUAL_SPEECH) {
                    println("[INFO] Casual speech or low priority event ignored.")
                }
            }
        }
        if (response.classification != Classification.CASUAL_SPEECH) {
            println("------------------------------\n")
        }
    }
}

