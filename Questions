class MainActivity : ComponentActivity() {

    private var service: SilentCommService? = null
    private val mainActivityScope = CoroutineScope(Dispatchers.Default + SupervisorJob())
    private val dbManager = FirestoreManager()
    private val permissionsManager = PermissionsManager()
    private var userId: String? = null

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        val token = "jwt-canvas-auth-12345" // Hardcoded from original main

        setContent {
            var buttonEnabled by remember { mutableStateOf(true) }
            var text by remember { mutableStateOf("Start Simulation") }

            Surface(modifier = Modifier.fillMaxSize(), color = MaterialTheme.colorScheme.background) {
                Column(
                    modifier = Modifier.fillMaxSize(),
                    verticalArrangement = Arrangement.Center,
                    horizontalAlignment = Alignment.CenterHorizontally
                ) {
                    Button(
                        onClick = {
                            buttonEnabled = false
                            text = "Simulation Running..."
                            lifecycleScope.launch {
                                // This is the logic from the old `onCreate` and `main`
                                println("\n[MAIN] Application Starting...")

                                // STEP 1: Auth
                                println("\n[INITIALIZATION] Step 1: Initiating Google/Gemini Authentication...")
                                try {
                                    userId = dbManager.authenticate(token)
                                    println("[AUTH] Authentication successful. User ID: $userId")
                                } catch (_: Exception) {
                                    println("[MAIN] Authentication failed.")
                                    return@launch
                                }

                                // STEP 2: Permissions
                                println("\n[INITIALIZATION] Step 2: Requesting Critical System Permissions...")
                                val permissionsGranted = permissionsManager.requestEssentialPermissions()

                                if (permissionsGranted) {
                                    // STEP 3: Dashboard and Service
                                    showDashboard(userId!!)
                                    println("\n[SIMULATION] Running 24/7 monitoring for 60 simulated seconds...")
                                    delay(60.seconds)
                                    stopMonitoring()
                                    println("\n[SIMULATION] Application gracefully terminated.")
                                    text = "Simulation Finished. Relaunch app to run again."

                                } else {
                                    println("[MAIN] Failed to secure all critical permissions. Service cannot start.")
                                    text = "Permission failed. Relaunch app to try again."
                                }
                            }
                        },
                        enabled = buttonEnabled
                    ) {
                        Text(text)
                    }
                }
            }
        }
    }

    private fun showDashboard(id: String) {
        println("\n[UI] Displaying Silent Communicator Dashboard for User: $id")
        println("[UI] Status: Ready. Tap 'START' to activate 24/7 monitoring.")
        startMonitoring(id)
    }

    private fun startMonitoring(id: String) {
        if (service == null) {
            service = SilentCommService(id)
            println("[ANDROID] Starting Foreground Service (Type: microphone, location) with Notification ID $FOREGROUND_SERVICE_NOTIFICATION_ID.")
            mainActivityScope.launch {
                service?.startProcessingLoop()
            }
        }
    }

    private fun stopMonitoring() {
        service?.stopMonitoring()
        service = null
        mainActivityScope.cancel()
        println("[ANDROID] Foreground Service stopped.")
    }

    override fun onDestroy() {
        super.onDestroy()
        stopMonitoring()
    }
}
