class MainActivity(private val context: Context, private val token: String, private val apiKey: String) {
    private val dbManager = FirestoreManager("default-app-id")
    private var userId: String? = null
    private var service: SilentCommService? = null

    suspend fun onCreate() {
        println("\n[MAIN] Application Starting...")

        // 1. Authenticate User (Mocked Firebase Auth)
        try {
            userId = dbManager.authenticate(token)
            println("[MAIN] Authentication successful. User ID: $userId")
            showDashboard(userId!!)
        } catch (e: Exception) {
            println("[MAIN] Authentication failed.")
        }
    }

    private fun showDashboard(id: String) {
        println("\n[UI] Displaying Silent Communicator Dashboard for User: $id")
        println("[UI] Status: Ready. Tap 'START' to activate 24/7 monitoring.")

        // In a real app, button clicks would call startMonitoring
        startMonitoring(id)
    }

    fun startMonitoring(id: String) {
        if (service == null) {
            // 2. Start Foreground Service
            service = SilentCommService(context, apiKey, id)
            // In a real app, this initiates the Android Service via startForegroundService(Intent)
            println("[ANDROID] Starting Foreground Service (Type: microphone, location) with Notification ID $FOREGROUND_SERVICE_NOTIFICATION_ID.")
            
            // Start the core logic loop in a coroutine
            kotlinx.coroutines.GlobalScope.launch {
                service?.startProcessingLoop()
            }
        }
    }

    fun stopMonitoring() {
        service?.stopProcessingLoop()
        service = null
        println("[ANDROID] Foreground Service stopped.")
    }
}

