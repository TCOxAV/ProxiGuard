class AlertManager(private val settings: UserSettings) {
    private val peripheralManager = PeripheralManager()

    private fun proximityCheck(alertLocation: Location, userLocation: Location, range: Double): Boolean {
        // Mocked distance calculation: returns true if outside range
        val distance = Random.nextDouble(50.0, 5000.0) // 50m to 5km
        val requiredRange = when (range) {
            1000.0 -> 1000.0 // 1km
            30.0 -> 30.0     // 30m
            else -> range
        }
        return distance > requiredRange
    }

    fun triggerAlertProtocol(response: AiResponse, userLocation: Location) {
        val severityParts = response.severity_level.split("_")
        val proximityRange = severityParts.firstOrNull()?.replace("m", "")?.replace("km", "")?.toDoubleOrNull()
            ?.let { if (severityParts.contains("km")) it * 1000 else it } ?: 0.0

        println("\n--- ALERT PROTOCOL TRIGGERED ---")
        println("Classification: ${response.classification}, Priority: ${response.priority}")
        println("Translated: ${response.translated_text}")

        when (response.classification) {
            Classification.EMERGENCY -> {
                println("[VISUAL] Displaying UNINTERRUPTIBLE POPUP: ${response.translated_text}")
                println("[HAPTIC] Sending SOS Vibration Pattern to Wearable (${settings.wearableConnectedId})")
                peripheralManager.sendHaptic(settings.sirenPreference)

                val alertLocation = userLocation // Assume emergency is around the user for now
                if (!proximityCheck(alertLocation, userLocation, proximityRange)) {
                    println("[LOCATION] User is WITHIN ${proximityRange}m proximity of the alert source.")
                    println("[AUTHORITY] Sending SMS to ${settings.emergencyContactNumber} with location.")
                    // Mock SMS intent logic here
                } else {
                    println("[LOCATION] User is OUTSIDE safety range.")
                }
            }
            Classification.COMMAND -> {
                println("[UI] Displaying command: ${response.translated_text}")
                if (response.command_data.action == CommandAction.NAVIGATION && response.command_data.target != null) {
                    println("[ACTION] Initiating Google Maps navigation to: ${response.command_data.target}")
                }
            }
            Classification.ANNOUNCEMENT -> {
                println("[UI] Displaying announcement: ${response.translated_text}")
                if (settings.wearableConnectedId != null) {
                    println("[TTS] Streaming announcement to Bluetooth earpiece.")
                    peripheralManager.sendHaptic("SOFT_VIBRATION") // Soft notification
                }
            }
            else -> println("[INFO] Casual speech or low priority event ignored.")
        }
        println("------------------------------\n")
    }
}

